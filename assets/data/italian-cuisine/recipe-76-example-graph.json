{"meta":{"source":"Artusi","recipe_id":76,"recipe_name":"Risotto with mushrooms","recipe_original_title":"Risotto coi funghi"},"nodes":[{"id":"step:514","label":"Step 1","group":"step","meta":{"type":"Step","step_id":514,"order":1,"action":"chop","instruction":"Finely chop the onion, parsley, celery, and carrot to make a battuto.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:515","label":"Step 2","group":"step","meta":{"type":"Step","step_id":515,"order":2,"action":"saut\u00e9","instruction":"In a pan, saut\u00e9 the battuto in olive oil until it takes on some color.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:516","label":"Step 3","group":"step","meta":{"type":"Step","step_id":516,"order":3,"action":"simmer","instruction":"Add tomato sauce and water to the pan, season with salt and pepper, and add the whole garlic clove. Let it simmer.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:517","label":"Step 4","group":"step","meta":{"type":"Step","step_id":517,"order":4,"action":"chop","instruction":"While the sauce simmers, clean the fresh mushrooms and chop them to a size slightly smaller than a corn kernel.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:518","label":"Step 5","group":"step","meta":{"type":"Step","step_id":518,"order":5,"action":"cook","instruction":"Remove and discard the garlic clove from the sauce. Add the chopped mushrooms to the sauce and cook them through. Once cooked, set the mushroom mixture aside.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:519","label":"Step 6","group":"step","meta":{"type":"Step","step_id":519,"order":6,"action":"toast","instruction":"In a separate pot, toast the raw rice with a piece of butter.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:520","label":"Step 7","group":"step","meta":{"type":"Step","step_id":520,"order":7,"action":"cook","instruction":"Begin cooking the rice by adding hot water one ladleful at a time, stirring and waiting for the liquid to be absorbed before adding the next.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:521","label":"Step 8","group":"step","meta":{"type":"Step","step_id":521,"order":8,"action":"combine","instruction":"When the risotto is halfway cooked, stir in the cooked mushroom mixture and continue cooking until the rice is done.","duration_minutes":null,"temperature_celsius":null}},{"id":"step:522","label":"Step 9","group":"step","meta":{"type":"Step","step_id":522,"order":9,"action":"finish","instruction":"Before serving, stir in Parmesan cheese to taste.","duration_minutes":null,"temperature_celsius":null}},{"id":"ingredient:water","label":"water","group":"ingredient","meta":{"type":"Ingredient","name":"water","category":"ingredient"}},{"id":"ingredient:onion","label":"onion","group":"ingredient","meta":{"type":"Ingredient","name":"onion","category":"ingredient"}},{"id":"ingredient:salt","label":"salt","group":"ingredient","meta":{"type":"Ingredient","name":"salt","category":"ingredient"}},{"id":"ingredient:carrot","label":"carrot","group":"ingredient","meta":{"type":"Ingredient","name":"carrot","category":"ingredient"}},{"id":"ingredient:celery","label":"celery","group":"ingredient","meta":{"type":"Ingredient","name":"celery","category":"ingredient"}},{"id":"ingredient:butter","label":"butter","group":"ingredient","meta":{"type":"Ingredient","name":"butter","category":"ingredient"}},{"id":"ingredient:parsley","label":"parsley","group":"ingredient","meta":{"type":"Ingredient","name":"parsley","category":"ingredient"}},{"id":"ingredient:parmesan cheese","label":"parmesan cheese","group":"ingredient","meta":{"type":"Ingredient","name":"parmesan cheese","category":"ingredient"}},{"id":"ingredient:pepper","label":"pepper","group":"ingredient","meta":{"type":"Ingredient","name":"pepper","category":"ingredient"}},{"id":"ingredient:rice","label":"rice","group":"ingredient","meta":{"type":"Ingredient","name":"rice","