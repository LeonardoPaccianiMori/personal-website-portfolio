---
layout: default
---
{% assign tags = page.tags | join: '' %}
{% assign read_time = page.reading_minutes %}
{% assign writing_type = 'Writing' %}
{% assign writing_back_url = '/writing/' %}
{% assign writing_back_label = 'writing' %}
{% if page.technical_kind == 'appendix' %}
  {% assign writing_type = 'Technical appendix' %}
  {% assign writing_back_url = '/notes/' %}
  {% assign writing_back_label = 'technical appendices' %}
{% elsif page.categories contains 'technical-notes' %}
  {% assign writing_type = 'Technical note' %}
  {% assign writing_back_url = '/notes/' %}
  {% assign writing_back_label = 'technical notes' %}
{% elsif page.categories contains 'thoughts' %}
  {% assign writing_type = 'Thought' %}
  {% assign writing_back_url = '/thoughts/' %}
  {% assign writing_back_label = 'thoughts' %}
{% endif %}

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post site-article">
  <header class="post-header site-article-header">
    <nav class="site-back-link" aria-label="Writing navigation">
      <a href="{{ writing_back_url | relative_url }}"><span aria-hidden="true">←</span> {{ writing_back_label }}</a>
    </nav>
    <p class="career-eyebrow">{{ writing_type }}</p>
    {% if page.project_slug %}
      {% assign parent_url = page.project_slug | prepend: '/projects/' | append: '/' %}
      {% assign parent_project = site.projects | where: 'url', parent_url | first %}
      <p class="site-article-project">
        <a href="{{ parent_project.url | relative_url }}">Project: {{ parent_project.title }}</a>
      </p>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
    <div class="site-article-meta">
      <span>{{ page.date | date: '%B %d, %Y' }}</span>
      {% if page.technical_kind == 'appendix' %}
        <span>Reference</span>
      {% elsif read_time %}
        <span>{{ read_time }} min read</span>
      {% endif %}
      {% if page.last_updated %}
        <span>Updated {{ page.last_updated | date: '%B %d, %Y' }}</span>
      {% endif %}
      {% if page.author %}
        <span>By {{ page.author }}</span>
      {% endif %}
    </div>
    {% if tags != '' %}
      <div class="site-tag-list" aria-label="Article tags">
        {% for tag in page.tags %}
          <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </header>

  <article class="post-content site-reading-content site-prose">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        <p class="career-eyebrow">On this page</p>
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.project_slug %}
    {% assign companions = site.posts | where: 'project_slug', page.project_slug | sort: 'date' %}
    <nav class="site-article-companions" aria-label="Related project reading">
      <p class="career-eyebrow">More from this project</p>
      <ul>
        <li><a href="{{ parent_project.url | relative_url }}">Project overview</a></li>
        {% for companion in companions %}
          {% unless companion.url == page.url %}
            <li>
              <a href="{{ companion.url | relative_url }}">{{ companion.title }}</a>
            </li>
          {% endunless %}
        {% endfor %}
      </ul>
    </nav>
  {% endif %}

  <nav class="site-article-footer" aria-label="More writing">
    <span>Continue exploring</span>
    <a href="{{ '/writing/' | relative_url }}">All writing <span aria-hidden="true">→</span></a>
  </nav>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
</div>
