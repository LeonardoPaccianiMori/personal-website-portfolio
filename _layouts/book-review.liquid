---
layout: default
---
{% assign tags = page.tags | join: '' %}
{% assign clean_content = content | strip %}
{% assign status = page.status | downcase | strip %}

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post site-book-review">
  <nav class="site-back-link" aria-label="Book navigation">
    <a href="{{ '/books/' | relative_url }}"><span aria-hidden="true">←</span> bookshelf</a>
  </nav>

  <header class="site-book-review__hero">
    <div class="site-book-review__copy">
      <p class="career-eyebrow">Bookshelf · {{ status | default: 'note' }}</p>
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.subtitle %}
        <p class="site-book-review__subtitle">{{ page.subtitle }}</p>
      {% endif %}
      <p class="site-book-review__byline">
        {% if page.author %}
          {{ page.author }}
        {% endif %}
        {% if page.author and page.released %}
          <span aria-hidden="true">·</span>
        {% endif %}
        {% if page.released %}
          {{ page.released }}
        {% endif %}
      </p>

      <div class="site-book-review__facts">
        {% if page.started %}
          <span><strong>Started</strong> {{ page.started | date: '%B %-d, %Y' }}</span>
        {% endif %}
        {% if page.finished %}
          <span><strong>Finished</strong> {{ page.finished | date: '%B %-d, %Y' }}</span>
        {% endif %}
        {% if page.stars %}
          <span class="site-book-stars" aria-label="{{ page.stars }} out of 5 stars">
            {% assign full_stars = page.stars | floor %}
            {% assign half_star = page.stars | minus: full_stars %}
            {% assign empty_stars = 5 | minus: full_stars %}
            {% if half_star > 0 %}
              {% assign empty_stars = empty_stars | minus: 1 %}
            {% endif %}
            {% for i in (1..full_stars) -%}
              <i class="fa-solid fa-star fa-sm" aria-hidden="true"></i>
            {%- endfor -%}
            {%- if half_star > 0 %}<i class="fa-solid fa-star-half-stroke fa-sm" aria-hidden="true"></i>{% endif -%}
            {%- for i in (1..empty_stars) -%}
              <i class="fa-regular fa-star fa-sm" aria-hidden="true"></i>
            {%- endfor %}
          </span>
        {% endif %}
      </div>

      {% if tags != '' %}
        <div class="site-tag-list" aria-label="Book tags">
          {% for tag in page.tags %}
            <a href="{{ tag | slugify | prepend: '/books/tag/' | relative_url }}">{{ tag }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <figure class="site-book-review__cover">
      {% if page.cover %}
        <img alt="{{ page.title }} cover" src="{{ page.cover | relative_url }}">
      {% elsif page.olid %}
        <img alt="{{ page.title }} cover" src="https://covers.openlibrary.org/b/olid/{{ page.olid }}-L.jpg?default=false">
      {% elsif page.isbn %}
        <img alt="{{ page.title }} cover" src="https://covers.openlibrary.org/b/isbn/{{ page.isbn }}-L.jpg?default=false">
      {% endif %}
      <figcaption>
        {% if status != '' %}
          <span class="site-book-status site-book-status--{{ status }}">{{ status }}</span>
        {% endif %}
      </figcaption>
    </figure>
  </header>

  {% if clean_content != '' %}
    <article class="site-reading-content site-prose site-book-note">
      <p class="career-eyebrow">My note</p>
      {{ content }}
    </article>
  {% else %}
    <div class="site-reading-content site-empty-state site-book-note">
      <p class="career-eyebrow">My note</p>
      <p>No note yet.</p>
    </div>
  {% endif %}

  <nav class="site-article-footer" aria-label="More books">
    <span>Continue exploring</span>
    <a href="{{ '/books/' | relative_url }}">Back to the bookshelf <span aria-hidden="true">→</span></a>
  </nav>
</div>
