---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% assign book_rows = '' %}
    {% assign row_delimiter = '||BOOK_ROW||' %}
    {% assign field_delimiter = '||BOOK_FIELD||' %}
    {% for item in collection %}
      {% if item.finished %}
        {% assign display_year = item.finished | date: '%Y' %}
      {% elsif item.started %}
        {% assign display_year = item.started | date: '%Y' %}
      {% else %}
        {% assign display_year = item.date | date: '%Y' %}
      {% endif %}

      {% assign display_year_number = display_year | plus: 0 %}
      {% assign year_sort_number = 9999 | minus: display_year_number %}
      {% assign year_sort_key = year_sort_number | prepend: '0000' | slice: -4, 4 %}

      {% assign status = item.status | downcase | strip %}
      {% case status %}
        {% when 'reading' %}
          {% assign status_sort_key = '0' %}
        {% when 'paused' %}
          {% assign status_sort_key = '1' %}
        {% when 'finished' %}
          {% assign status_sort_key = '2' %}
        {% when 'reread' %}
          {% assign status_sort_key = '3' %}
        {% when 'interested' %}
          {% assign status_sort_key = '4' %}
        {% when 'queued' %}
          {% assign status_sort_key = '5' %}
        {% when 'abandoned' %}
          {% assign status_sort_key = '6' %}
        {% else %}
          {% assign status_sort_key = '7' %}
      {% endcase %}

      {% if item.finished %}
        {% assign finished_date_number = item.finished | date: '%Y%m%d' | plus: 0 %}
        {% assign finished_sort_number = 99999999 | minus: finished_date_number %}
        {% assign finished_sort_key = finished_sort_number | prepend: '00000000' | slice: -8, 8 %}
      {% else %}
        {% assign finished_sort_key = '99999999' %}
      {% endif %}

      {% if item.started %}
        {% assign started_date_number = item.started | date: '%Y%m%d' | plus: 0 %}
        {% assign started_sort_number = 99999999 | minus: started_date_number %}
        {% assign started_sort_key = started_sort_number | prepend: '00000000' | slice: -8, 8 %}
      {% else %}
        {% assign started_sort_key = '99999999' %}
      {% endif %}

      {% case status %}
        {% when 'finished', 'reread' %}
          {% assign date_sort_key = finished_sort_key %}
        {% when 'reading', 'paused' %}
          {% assign date_sort_key = started_sort_key %}
        {% else %}
          {% assign date_sort_key = '99999999' %}
      {% endcase %}

      {% assign title_sort_key = item.title | default: '' | downcase %}
      {% capture book_row %}{{ year_sort_key }}-{{ status_sort_key }}-{{ date_sort_key }}-{{ title_sort_key }}{{ field_delimiter }}{{ display_year }}{{ field_delimiter }}{{ item.url }}{% endcapture %}
      {% assign book_rows = book_rows | append: book_row | append: row_delimiter %}
    {% endfor %}

    {% assign sorted_book_rows = book_rows | split: row_delimiter | sort %}
    {% assign active_year = '' %}
    {% assign has_open_list = false %}
    {% for book_row in sorted_book_rows %}
      {% if book_row != '' %}
        {% assign row_parts = book_row | split: field_delimiter %}
        {% assign current_year = row_parts[1] %}
        {% assign item_url = row_parts[2] %}
        {% assign item = collection | where: 'url', item_url | first %}
        {% if item %}
          {% if current_year != active_year %}
            {% if has_open_list %}
              </ul>
            {% endif %}
            <h1 id="y{{ current_year }}">
              <a href="{{ current_year | prepend: '/books/' | relative_url }}">{{ current_year }}</a>
            </h1>
            <ul>
            {% assign active_year = current_year %}
            {% assign has_open_list = true %}
          {% endif %}

          <figure class="cover">
            <a class="cover-link" href="{{ item.url | relative_url }}">
              {% if item.cover %}
                <img alt="{{ item.title }} cover" src="{{ item.cover | prepend: page.covers | relative_url }}" style="height:200px">
              {% elsif item.olid %}
                <img alt="{{ item.title }} cover" src="http://covers.openlibrary.org/b/olid/{{ item.olid }}-L.jpg?default=false" style="height:200px">
              {% elsif item.isbn %}
                <img alt="{{ item.title }} cover" src="http://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false" style="height:200px">
              {% endif %}
              {% if item.status %}
                {% assign statuses = 'abandoned,finished,interested,paused,queued,reading,reread' | split: ',' %}
                {% assign status = item.status | downcase | strip %}
                {% if statuses contains status %}
                  <figcaption class="{{ status | downcase }}">{{ status | upcase }}</figcaption>
                {% else %}
                  <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
                {% endif %}
              {% else %}
                <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
              {% endif %}
            </a>
          </figure>
        {% endif %}
      {% endif %}
      {% if forloop.last %}
        {% if has_open_list %}
          </ul>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
