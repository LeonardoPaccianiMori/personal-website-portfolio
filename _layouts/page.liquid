---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign is_project = false %}
{% if page.collection == 'projects' %}
  {% assign is_project = true %}
{% endif %}

<div class="post site-page {% if page.wide %}site-page--wide{% endif %} {% if is_project %}site-page--project{% endif %}">
  <header class="site-page-header">
    {% if is_project %}
      <nav class="site-back-link" aria-label="Project navigation">
        <a href="{{ '/projects/' | relative_url }}"><span aria-hidden="true">←</span> all projects</a>
      </nav>
      <p class="career-eyebrow">
        {% case page.category %}
          {% when 'professional' %}
            Professional case study
          {% when 'portfolio' %}
            Personal project
          {% when 'experimental' %}
            Experimental project
          {% else %}
            Project
        {% endcase %}
      </p>
    {% elsif page.eyebrow %}
      <p class="career-eyebrow">{{ page.eyebrow }}</p>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article
    id="markdown-content"
    class="site-page-content {% if is_project %}site-project-content site-prose{% elsif page.wide %}site-wide-content{% else %}site-reading-content site-prose{% endif %}"
  >
    {{ content }}
  </article>
</div>
