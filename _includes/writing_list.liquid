{% assign writing_posts = include.posts %}
{% assign writing_limit = include.limit | default: writing_posts.size %}

{% if writing_posts.size > 0 %}
  <div class="site-writing-list">
    {% for post in writing_posts limit: writing_limit %}
      {% assign read_time = post.reading_minutes %}
      {% assign writing_label = 'Writing' %}
      {% if post.technical_kind == 'appendix' %}
        {% assign writing_label = 'Technical appendix' %}
      {% elsif post.categories contains 'technical-notes' %}
        {% assign writing_label = 'Technical note' %}
      {% elsif post.categories contains 'thoughts' %}
        {% assign writing_label = 'Thought' %}
      {% endif %}

      <article class="site-writing-card">
        <div class="site-writing-card__meta">
          <span>{{ writing_label }}</span>
          <span>{{ post.date | date: '%B %Y' }}</span>
          {% if post.technical_kind == 'appendix' %}
            <span>Reference</span>
          {% elsif read_time %}
            <span>{{ read_time }} min</span>
          {% endif %}
        </div>
        <div class="site-writing-card__body">
          <h3>
            <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
          </h3>
          <p>{{ post.description }}</p>
        </div>
        <a class="site-writing-card__arrow" href="{{ post.url | relative_url }}" aria-label="Read {{ post.title }}">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
      </article>
    {% endfor %}
  </div>
{% else %}
  <div class="site-empty-state">
    <p class="career-eyebrow">Coming later</p>
    <p>{{ include.empty_message }}</p>
  </div>
{% endif %}
