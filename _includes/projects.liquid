<article class="site-project-card">
  {% if project.img %}
    <a
      class="site-project-card__image"
      href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
      tabindex="-1"
      aria-hidden="true"
    >
      <img src="{{ project.img | relative_url }}" alt="" loading="lazy">
    </a>
  {% endif %}
  <div class="site-project-card__body">
    <p class="site-project-card__type">
      {% case project.category %}
        {% when 'work' %}
          Professional work
        {% when 'portfolio' %}
          Personal project
        {% when 'foundations' %}
          Foundations
        {% else %}
          Project
      {% endcase %}
    </p>
    <h3>
      <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
        {{- project.title -}}
      </a>
    </h3>
    <p>{{ project.description }}</p>
    <div class="site-project-card__links">
      <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
        Read the case study
        <svg class="site-project-card__arrow" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="M5 12h14"></path>
          <path d="m13 6 6 6-6 6"></path>
        </svg>
      </a>
      {% if project.github %}
        <a href="{{ project.github }}" aria-label="View {{ project.title }} source code">
          <i class="fa-brands fa-github" aria-hidden="true"></i> Code
        </a>
      {% endif %}
    </div>
  </div>
</article>
